ABUSEIPDB_API_KEY=

# localhost values below are for one-off host-side scripts (storage/setup_postgres.py,
# the backfill producers in ingestion/). The containerized services (api, live-replay,
# spark-master) get postgres/kafka:19092 injected directly in docker-compose.yml —
# nothing here needs to change to run `docker compose up`.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ghostnet
POSTGRES_PASSWORD=ghostnet
POSTGRES_DB=ghostnet
